    "problem_statement": "wrong result: `solveset((y + 1) ** 2 - y * (y + 2) > 0, x, S.Reals)`\n\nsympy commit hash: 06fcaef06d1e72684a46659b055eeee6169567ad (current master)\npython version: 3.12.3\nOS: Ubuntu 24.04.4 LTS\n\n```python\nIn [1]: x, y = symbols('x y')\n\nIn [2]: solveset((y + 1) ** 2 - y * (y + 2) > 0, x, S.Reals)\nOut[2]: \u2205\nexpected result = \u211d\n```\n\n\n",
    "hints_text": "",
    "patch": "diff --git a/sympy/solvers/solveset.py b/sympy/solvers/solveset.py\nindex 65a3045e4b..7666862577 100644\n--- a/sympy/solvers/solveset.py\n+++ b/sympy/solvers/solveset.py\n@@ -1270,7 +1270,16 @@ def _solveset(f, symbol, domain, _check=False):\n \n     result = S.EmptySet\n \n-    if f.expand().is_zero:\n+    expanded = f.expand()\n+    if f.is_Relational and not expanded.has(symbol):\n+        expanded = expanded.simplify()\n+        if expanded is S.true:\n+            return domain\n+        elif expanded is S.false:\n+            return S.EmptySet\n+        return ConditionSet(symbol, expanded, domain)\n+\n+    if expanded.is_zero:\n         return domain\n     elif not f.has(symbol):\n         return S.EmptySet\n",
    "test_patch": "diff --git a/sympy/solvers/tests/test_solveset.py b/sympy/solvers/tests/test_solveset.py\nindex f82763c6aa..18d56e2c7d 100644\n--- a/sympy/solvers/tests/test_solveset.py\n+++ b/sympy/solvers/tests/test_solveset.py\n@@ -3761,6 +3761,41 @@ def test_issue_25781():\n     assert solve(sqrt(x/2) - x) == [0, S.Half]\n \n \n+def test_issue_30584():\n+    x, y = symbols('x y')\n+    relation = (y + 1)**2 - y*(y + 2)\n+\n+    assert solveset(relation > 0, x, S.Reals) == S.Reals\n+    assert solveset(relation < 0, x, S.Reals) is S.EmptySet\n+\n+\n+def test_solveset_symbol_independent_relational():\n+    x, y = symbols('x y')\n+\n+    assert solveset(y > 0, x, S.Reals) == \\\n+        ConditionSet(x, y > 0, S.Reals)\n+    assert solveset(Eq(y, 0), x, S.Reals) == \\\n+        ConditionSet(x, Eq(y, 0), S.Reals)\n+    assert solveset(y, x, S.Reals) is S.EmptySet\n+\n+\n+def test_solveset_symbol_independent_relational_after_expansion():\n+    x, y = symbols('x y')\n+    relation = (x + y)**2 - x**2 - 2*x*y\n+\n+    assert solveset(relation, x, S.Reals) is S.EmptySet\n+    assert solveset(Eq(relation, 0), x, S.Reals) == \\\n+        ConditionSet(x, Eq(y**2, 0), S.Reals)\n+    assert solveset(relation > 0, x, S.Reals) == \\\n+        ConditionSet(x, y**2 > 0, S.Reals)\n+    assert solveset(relation >= y**2, x, S.Reals) == S.Reals\n+    assert solveset(relation > y**2, x, S.Reals) is S.EmptySet\n+\n+    relation = (x + 1)**2 - x*(x + 2)\n+    assert solveset(relation > 0, x, S.Reals) == S.Reals\n+    assert solveset(relation < 0, x, S.Reals) is S.EmptySet\n+\n+\n def test_issue_26077():\n     _n = Symbol('_n')\n     function = x*cot(5*x)\n",
